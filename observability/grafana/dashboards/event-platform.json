{
  "title": "Event Platform — Golden Signals",
  "uid": "event-platform",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "type": "timeseries", "title": "Eventos ingeridos/s por resultado",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "sum by (outcome) (rate(events_ingested_total[1m]))", "legendFormat": "{{outcome}}"}]
    },
    {
      "type": "timeseries", "title": "Latência de ingestão (p50/p95/p99)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.2}]}}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/events.*\",method=\"POST\"}[1m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/events.*\",method=\"POST\"}[1m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/events.*\",method=\"POST\"}[1m])))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries", "title": "Eventos persistidos/s",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "sum(rate(events_persisted_total[1m]))", "legendFormat": "persistidos"}]
    },
    {
      "type": "timeseries", "title": "Lag por grupo de consumo",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "sum by (consumergroup) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}}"}]
    },
    {
      "type": "timeseries", "title": "Duração do lote de persistência (p95)",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "datasource": {"uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(events_persistence_batch_duration_seconds_bucket[1m])))", "legendFormat": "p95"}]
    },
    {
      "type": "stat", "title": "Circuit breaker downstream",
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "max by (state) (resilience4j_circuitbreaker_state{name=\"downstream\"})", "legendFormat": "{{state}}"}]
    },
    {
      "type": "stat", "title": "Mensagens inválidas (poison) 15m",
      "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
      "datasource": {"uid": "prometheus"},
      "targets": [{"expr": "sum(increase(events_poison_total[15m]))"}]
    },
    {
      "type": "timeseries", "title": "Pool de conexões (Hikari)",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 4},
      "datasource": {"uid": "prometheus"},
      "targets": [
        {"expr": "sum(hikaricp_connections_active)", "legendFormat": "ativas"},
        {"expr": "sum(hikaricp_connections_pending)", "legendFormat": "aguardando"}
      ]
    }
  ]
}
